# Go
/quotapulse
*.test
*.out

# Frontend deps and test artifacts; ui/dist is committed — the binary embeds it
ui/node_modules/
ui/dist-test/

# Environment variables (including secrets)
.env
.env.local
.env.*.local
*.env.backup*

# Data and logs
data/
logs/
*.db
*.sqlite
*.sqlite3

# But test fixtures belong in the repo: the testdata database proves we can open
# existing production data directly. Blocked by *.db above, the test would be green
# locally and data-less in CI. It contains only fabricated data (AK:SK / sk-old / pw).
!**/testdata/*.db

# Legacy config file, no longer read; kept so historical files are not committed by accident
config.json

# Kubernetes secrets
k8s/secret.yaml
k8s/*-secret.yaml

# Editors and OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Host-specific deployment files (never commit)
docker-compose.override.yml
docker-compose.override.yml.bak*
.env.bak*
__pycache__/
