# QuotaPulse reads very little from the environment: only what it needs to
# start. What to watch, where to notify and how to behave are set in the
# dashboard and stored in the database.
#
# Do not write comments after a value on the same line.

# Signs you in to the dashboard. Required: without it nobody can sign in.
QUOTAPULSE_PASSWORD=

# Encrypts stored credentials. Optional: when unset, a random key is created
# in the data directory on first start (data/secret.key). Set it if you would
# rather keep the key out of the data directory — and never change it
# afterwards, or stored credentials can no longer be read.
# QUOTAPULSE_SECRET=

# Time zone and language (en or zh) for a NEW install. Both can be changed in
# the dashboard later; these only decide what a fresh database starts with.
# TZ=Asia/Shanghai
# QUOTAPULSE_LANG=zh

# A bundle to import when the database is empty: a declarative way to start
# with accounts, dates and channels already in place. See docs/bundle.md.
# QUOTAPULSE_BOOTSTRAP=/data/bootstrap.json

# 1 records notifications without sending them. Useful while checking a
# migration: the Activity page shows what would have gone out.
# QUOTAPULSE_MUTE=1

# Logging: text or json; debug, info, warn or error.
# QUOTAPULSE_LOG=json
# QUOTAPULSE_LOG_LEVEL=info

# Docker Compose only.
#
# Where the dashboard is published on the host: a port, or address:port to
# keep it on loopback behind a reverse proxy on the same machine.
# QUOTAPULSE_PORT=8080
# QUOTAPULSE_PORT=127.0.0.1:8080
#
# The release to run. Pin it: "latest" changes under you at the next pull.
# QUOTAPULSE_VERSION=1.0.2
#
# Another image altogether - a fork, a mirror - instead of the published one.
# QUOTAPULSE_IMAGE=
#
# The user to run as when ./data belongs to you rather than to the image's
# user (65532).
# QUOTAPULSE_USER=1000:1000
