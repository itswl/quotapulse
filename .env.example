# Copy this file to .env, fill in the real values, then run:
#   cp .env.example .env
#   ./quotapulse -show-config
#
# Do not add inline comments after values. A '#' in a value is data; put comments
# on their own lines.

# ---------- Required ----------
# Web/API key. All /api/* endpoints return 503 when it is unset.
WEB_API_KEY=change-me

# Optional read-only MCP endpoint at /mcp; it uses WEB_API_KEY authentication.
# ENABLE_MCP=false

# Alert Webhook. Supported types: feishu, dingtalk, wecom, custom.
WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/YOUR_TOKEN
WEBHOOK_TYPE=feishu
WEBHOOK_SOURCE=quotapulse

# ---------- Provider credentials ----------
# Any {PROVIDER}_API_KEY becomes an automatically discovered project.
# {PROVIDER}_THRESHOLD enables threshold alerts and {PROVIDER}_OWNER_PROJECT adds a group label.
# Multiple accounts use {PROVIDER}_1_API_KEY, {PROVIDER}_2_API_KEY, and so on.
OPENROUTER_API_KEY=sk-or-v1-xxx
UNIAPI_API_KEY=uniapi-xxx
WXRANK_API_KEY=xxx
TIKHUB_API_KEY=xxx
DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_THRESHOLD=50                 Alert below 50; omit to monitor without alerting.
# GLM_API_KEY uses the id.secret format for the Coding Plan quota percentage.
GLM_API_KEY=xxx.xxx
# Volcengine and Alibaba Cloud use the ID:Secret format.
VOLC_1_API_KEY=AKLT_ACCESS_KEY:SECRET_KEY_BASE64
VOLC_2_API_KEY=AKLT_ACCESS_KEY:SECRET_KEY_BASE64
ALIYUN_1_API_KEY=ACCESS_KEY_ID:ACCESS_KEY_SECRET

# ---------- Email scanning ----------
# A mailbox is discovered when host, username, and password are all set.
# EMAIL_HOST=imap.example.com
# EMAIL_USERNAME=me@example.com
# EMAIL_PASSWORD=
# EMAIL_PORT=993                        Default: 993
# EMAIL_USE_SSL=true                    Default: true
# EMAIL_NAME=work-mailbox               Defaults to the username
# Multiple mailboxes use EMAIL_1_HOST, EMAIL_2_HOST, and matching variables.
# EMAIL_ALERT_KEYWORDS=                 Replace the default keyword list.
# EMAIL_EXTRA_ALERT_KEYWORDS=           Append to the default keyword list.

# ---------- Optional feature flags (all disabled by default) ----------
# ENABLE_DATABASE=true                  Required for history and dynamic configuration.
# ENABLE_DYNAMIC_CONFIG=true            Manage projects from the Web UI.
# ENABLE_HISTORY_API=true               Enable history query endpoints and trend charts.
# ENABLE_SUBSCRIPTIONS=true             Enable renewal reminders.
# ENABLE_EMAIL_SCAN=true                Show Email scanning before any mailbox is configured,
#                                       to add the first one on the dashboard (a configured
#                                       mailbox shows it anyway).
# ENABLE_PROMETHEUS=true                Expose Prometheus metrics on port 9100.
# ENABLE_WEB_ALARM=true                 Allow dashboard refreshes to send real alerts.

# ---------- Scheduling and tuning ----------
# BALANCE_REFRESH_INTERVAL_SECONDS=3600 Dashboard refresh interval.
# ALERT_SCHEDULE=09:00,15:00            Balance and subscription checks; use off to disable.
# EMAIL_SCAN_SCHEDULE=10:00             Scheduled email scan; use off to disable.
# EMAIL_SCAN_DAYS=1                     Number of recent days to scan, from 1 to 30.
# WEEKLY_REPORT_SCHEDULE=Mon 09:00      Weekly report; use Mon/Tuesday/... or ISO day numbers.
# BURN_RATE_WINDOW_DAYS=7               Number of days used for burn-rate history.
# RUNWAY_ALERT_DAYS=7                   Alert when estimated runway is below this many days.
# SPEND_SPIKE_RATIO=3                   Alert when today's spend reaches this multiple of baseline.
# SPEND_SPIKE_MIN_AMOUNT=1              Ignore spikes below this absolute amount.
# MAX_CONCURRENT_CHECKS=20              Concurrent provider checks, from 1 to 50.
# ALERT_COOLDOWN_SECONDS=86400          Per-project alert cooldown.
# SUBSCRIPTION_ALERT_COOLDOWN_SECONDS=86400
# RESPONSE_CACHE_TTL=300                Balance response cache in seconds.
# LOG_LEVEL=INFO                        DEBUG / INFO / WARNING / ERROR.
# LOG_FORMAT=text                       text or json.
# LOG_FILE=logs/quotapulse.log
# SHUTDOWN_DELAY_SECONDS=0              Continue serving after SIGTERM; 15 is recommended on Kubernetes.

# ---------- Database (active when ENABLE_DATABASE=true) ----------
# Choose SQLite, PostgreSQL, or MySQL:
# DATABASE_URL=sqlite:///./data/quotapulse.db
# DATABASE_URL=postgresql://user:pass@host:5432/quotapulse
# DATABASE_URL=mysql://user:pass@host:3306/quotapulse?charset=utf8mb4
# A +driver suffix is accepted; only the part before '+' selects the database.
#
# Database API keys and mailbox passwords are encrypted when this is set.
# Generate a Fernet key with:
#   openssl rand -base64 32 | tr '+/' '-_'
# A sufficiently long passphrase also works; it is hashed with SHA-256.
# CONFIG_ENCRYPTION_KEY=

# ---------- Deployment ----------
# Image tag. Defaults to latest; pin a version in production.
# QUOTAPULSE_VERSION=0.1.0

# ---------- Grafana (only with docker-compose.monitoring.yml) ----------
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change-me

# ── 可靠性 / Reliability ──────────────────────────────────────────────
# 连续失败 N 次后通过 webhook 升级告警，0 关闭
#JOB_FAILURE_ALERT_THRESHOLD=3
# 定时任务单次运行超时（秒），0 关闭
#JOB_TIMEOUT_SECONDS=600
# SQLite 自动备份：每天几点执行（留空关闭）、备份目录、保留份数
#DB_BACKUP_SCHEDULE=03:00
#DB_BACKUP_DIR=backups
#DB_BACKUP_KEEP=7
