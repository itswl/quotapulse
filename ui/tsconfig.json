{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    // esbuild 负责产出，tsc 只做类型检查；两边职责不重叠才不会出现「能编译但类型错」
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,

    // No automatic @types: Node built-ins are declared in test/node-builtins.d.ts, and tools
    // installed with --no-save (puppeteer-core brings @types/node) must not make the local
    // typecheck pass where CI's fails.
    "types": [],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "test/**/*.d.ts", "scripts/**/*.ts"]
}
